# Copy to a private .env outside the checkout. Render AND Compose consume it.
PUBLIC_BASE_URL=https://social.example.com
WHATSAPP_PUBLIC_BASE_URL=https://whatsapp.example.com
# Empty disables the optional dashboard link.
DASHBOARD_URL=
# Optional WhatsApp web application, built from apps/whatsapp.
WHATSAPP_APP_ENABLED=false
WHATSAPP_APP_PUBLIC_URL=https://whatsapp.example.com
# NAS ACL-compatible non-root runtime identity.
WHATSAPP_APP_UID=1000
WHATSAPP_APP_GID=10
# Use oidc for Keycloak; basic retains the local setup mode.
APP_AUTH_MODE=basic
OIDC_ISSUER_URL=https://auth.example.com/realms/apps
OIDC_CLIENT_ID=whatsapp-socialmedia
OIDC_CLIENT_SECRET=
# Comma-separated stable Keycloak user IDs allowed to access every app account.
OIDC_ALLOWED_SUBJECTS=
OIDC_SESSION_TTL_SECONDS=2592000
APP_ENABLE_SENDING=false
# Enable connector writes separately from the MCP agent write gate.
WA_ENABLE_SENDING=false
HERMES_API_URL=
HERMES_API_KEY=
WHATSAPP_HERMES_ENABLED=false
HERMES_PROVIDER=socialmedia-litellm
HERMES_DEFAULT_MODEL=gpt-6-luna
WHATSAPP_APP_MCP_URL=http://mcp-sse:3010/mcp
# Comma-separated exact origins for legacy HTTP attachment references, if needed.
MEDIA_ALLOWED_ORIGINS=
# Bounded, account-scoped avatar cache; private/unavailable photos use a shorter TTL.
APP_AVATAR_CACHE_TTL_MS=30000
APP_AVATAR_NEGATIVE_CACHE_TTL_MS=5000
APP_AVATAR_CACHE_MAX_ENTRIES=256
APP_AVATAR_CACHE_MAX_BYTES=16777216
APP_AI_DEFAULT_MODEL=
# Optional comma-separated model allowlist; empty uses the LiteLLM catalog.
APP_AI_MODELS=
# Optional overrides; otherwise use LLM_BASE_URL / OPENAI_API_KEY.
LITELLM_BASE_URL=
LITELLM_API_KEY=
STACK_DIR=/volume2/docker/social-media
SOURCE_DIR=/home/staticduo/git/socialmedia
COMPOSE_PROJECT_NAME=socialmedia
STACK_NETWORK=socialmedia
NPM_NETWORK=npm_npm-net
LLM_NETWORK=llm-net

POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
NATS_IMAGE=nats:2.10-alpine
MINIO_IMAGE=quay.io/minio/minio:latest
GATEWAY_IMAGE=nginx:alpine
POSTGRES_HOST=socialmedia-postgres
POSTGRES_PORT=5432
POSTGRES_USER=whatsappmcp
POSTGRES_DB=whatsappmcp
POSTGRES_SSLMODE=disable
POSTGRES_PASSWORD=
# Optional complete connection URI; URL-encode credentials in this URI.
DATABASE_URL=
REDIS_URL=rediss://socialmedia-redis:6379
NATS_URL=tls://socialmedia-nats:4222
MINIO_ENDPOINT=socialmedia-minio:9000
MINIO_USE_SSL=true
MINIO_BUCKET=socialmedia-media
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
LLM_BASE_URL=http://litellm:4000/v1
EMBEDDING_BASE_URL=http://litellm:4000/v1
LLM_CHAT_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=qwen3-embedding-8b
EMBEDDING_DIMENSION=4096
OPENAI_API_KEY=
ENCRYPTION_KEY=
MCP_SSE_AUTH_TOKEN=
ENABLE_SENDING=false
WA_HISTORY_SYNC_ON_LOGIN=false
# Per account: WA_PERSONAL_HISTORY_SYNC_ON_LOGIN=true
EMERGENCY_DISABLE_SENDING=false
UI_AUTH_USERNAME=
UI_AUTH_PASSWORD=
WA_PERSONAL_SECRET=
WA_PERSONAL_SESSION_KEY=
WA_SECONDARY_SECRET=
WA_SECONDARY_SESSION_KEY=
INSTAGRAM_SECRET=
INSTAGRAM_INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Optional providers: blank retains each connector's upstream default.
INSTAGRAM_GRAPH_BASE_URL=
FACEBOOK_GRAPH_BASE_URL=
WHATSAPP_WEBSOCKET_URL=
WHATSAPP_ORIGIN=
WHATSAPP_LINK_BASE_URL=

# Optional per-account overrides; omit these to derive defaults.
# WA_PERSONAL_QR_PAGE_URL=${WHATSAPP_PUBLIC_BASE_URL}/accounts/personal/qr/page
# WA_PERSONAL_CONNECTOR_URL=http://whatsapp-personal:3001
# WA_PERSONAL_SESSION_PATH=/volume2/docker/social-media/src/connectors/whatsapp-web/session-data
# WA_SECONDARY_QR_PAGE_URL=${WHATSAPP_PUBLIC_BASE_URL}/accounts/secondary/qr/page
# INSTAGRAM_CONNECTOR_URL=http://instagram-connector:3003

# Optional connectors, not deployed by this Compose. Pass to their own services.
# GATEWAY_WEBHOOK_URL=https://gateway.example.com/webhooks/whatsapp
# CONNECTOR_URL=https://connector.example.com
# TRACKING_OPT_IN_BASE_URL=https://tracking.example.com/labels/track
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_API_VERSION=v25.0

# Optional external object storage (S3_* overrides MINIO_* when nonempty).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PREFIX=
S3_USE_SSL=
S3_PUBLIC_ENDPOINT=
S3_PRESIGN_EXPIRY_SECONDS=3600
LEGACY_MINIO_ENDPOINT=
LEGACY_MINIO_BUCKET=
LEGACY_MINIO_ACCESS_KEY=
LEGACY_MINIO_SECRET_KEY=
LEGACY_MINIO_USE_SSL=
# WA_PERSONAL_S3_PREFIX=
# WA_SECONDARY_S3_PREFIX=whatsapp/secondary
INSTAGRAM_INSTAGRAM_APP_ID=
INSTAGRAM_INSTAGRAM_APP_SECRET=
INSTAGRAM_INSTAGRAM_FB_ACCESS_TOKEN=
# HTTPS connector upstreams use nginx's system CA bundle by default.
# Set an absolute host CA bundle path for private certificates (regenerate).
GATEWAY_UPSTREAM_CA_FILE=
# Optional shared host certificate directory; omit to use STACK_DIR/config/certs.
# CERTS_DIR=/volume2/docker/social-media/config/certs
# App CA paths: omit to retain /certs/ca.crt. Explicit empty uses system trust.
# MINIO_CA_CERT=
# NATS_CA_CERT=
# REDIS_TLS_CA=
# NODE_EXTRA_CA_CERTS=
