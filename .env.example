# Database
POSTGRES_PASSWORD=change-me-in-production

# WhatsApp Connector
CONNECTOR_SHARED_SECRET=change-me-in-production
SESSION_ENCRYPTION_KEY=change-me-in-production

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# Feature Flags
ENABLE_SENDING=false
EMERGENCY_DISABLE_SENDING=false

# Optional semantic provider (brain remains the default).
SEMANTIC_PROVIDER=brain
BRAIN_SEARCH_URL=
BRAIN_MESSAGING_SEARCH_KEY=
HINDSIGHT_URL=https://hindsight.staticduo.com
HINDSIGHT_BANK_ID=socialmedia-staticduo
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_MS=10000
HINDSIGHT_RECALL_MAX_TOKENS=4096
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_SYNC_BATCH=100
HINDSIGHT_SYNC_INTERVAL_MS=30000
HINDSIGHT_SYNC_RETRY_MS=30000
# Pause indexing only; keep provider synchronization, documents and queues.
HINDSIGHT_SYNC_EXCLUDED_PLATFORMS=
HINDSIGHT_SYNC_SINCE=1970-01-01T00:00:00Z
HINDSIGHT_SYNC_CHAT_IDS=

# Ollama / Llama Local Configuration
# Use local LLM instead of OpenAI (default: true)
USE_LOCAL_LLM=true
# Model to use for chat completions (requires ~80GB RAM for 70B model)
OLLAMA_MODEL=llama3.1:70b
# Model for embeddings (lightweight, ~300MB)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Telegram Connector
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your-api-id
TELEGRAM_API_HASH=your-api-hash
# Session string (generated after first login)
TELEGRAM_SESSION_STRING=

# Instagram pairing per user (SC-1194 P1) — all inert while
# CREDENTIAL_STORE_ENABLED is off.
# CREDENTIAL_STORE_ENABLED=false
# CREDENTIAL_STORE_MASTER_KEY=            # base64 of 32 bytes (envelope encryption)
# DATABASE_URL=postgresql://user:pass@host:5432/whatsappmcp
# Instagram Login app credentials (App Dashboard → Instagram Login). Fall back
# to FACEBOOK_APP_ID / FACEBOOK_APP_SECRET when unset — only if the Instagram
# Login secret really equals the Facebook one.
# INSTAGRAM_LOGIN_APP_ID=
# INSTAGRAM_LOGIN_APP_SECRET=
# Registered Valid OAuth Redirect URI (exact match required in the Meta app):
# INSTAGRAM_OAUTH_REDIRECT_URI=https://whatsapp.e-dani.com/oauth/instagram/callback
# INSTAGRAM_OAUTH_STATE_TTL_SEC=600
