{
  "name": "@mcp-socialmedia/telegram-connector",
  "version": "1.0.0",
  "description": "Telegram connector for WhatsApp MCP Server",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:pairing": "tsx src/pairing/main.ts",
    "lint": "pnpm --filter @mcp-socialmedia/shared run build && eslint src/**/*.ts",
    "test": "pnpm --filter @mcp-socialmedia/shared run build && tsx --test src/credential-session.test.ts src/pairing/session-pool.test.ts src/pairing/app.test.ts",
    "generate-session": "tsx src/generate-session-mtcute.ts"
  },
  "dependencies": {
    "@mcp-socialmedia/shared": "workspace:*",
    "@mtcute/node": "^0.29.7",
    "express": "^4.18.2",
    "nats": "^2.18.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "big-integer": "^1.6.52",
    "pg": "^8.13.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "eslint": "^8.56.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
